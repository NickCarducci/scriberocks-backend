rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Rocks backup and other per-user subcollections. ({sub}/{doc=**}, not
    // {doc=**}: the recursive wildcard also matches the user document itself,
    // which would override the rules for it below.)
    match /scriberocks_users/{uid}/{sub}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    function srSignedIn() { return request.auth != null; }
    function srMember(groupId) {
      return srSignedIn() && exists(/databases/$(database)/documents/scriberocks_groups/$(groupId)/members/$(request.auth.uid));
    }
    function srBanned() {
      return exists(/databases/$(database)/documents/scriberocks_banned/$(request.auth.uid));
    }
    // Members under guardian controls post only after a guardian approved
    // posting (PermissionKit, recorded by the app). Both fields are reported by
    // the app; Apple gives the server no proof. A missing user doc = no controls.
    function srPostingAllowed() {
      let path = /databases/$(database)/documents/scriberocks_users/$(request.auth.uid);
      return !exists(path)
        || get(path).data.get('guardianControls', false) != true
        || get(path).data.get('postingApproved', false) == true;
    }

    // Minors-only groups (e.g. Young Writers) admit members whose account says
    // they're under 18 (isMinor, from the latest Declared Age Range answer).
    function srMayJoin(groupId) {
      let user = /databases/$(database)/documents/scriberocks_users/$(request.auth.uid);
      return get(/databases/$(database)/documents/scriberocks_groups/$(groupId)).data.get('minorsOnly', false) != true
        || (exists(user) && get(user).data.get('isMinor', false) == true);
    }

    // Terms acceptance and posting approval. guardianControls follows the
    // device's latest Declared Age Range answer (set and cleared by the app),
    // so turning 18 or lifted Communication Limits need no manual step.
    match /scriberocks_users/{uid} {
      allow read, write: if srSignedIn() && request.auth.uid == uid;
      match /blocks/{blockedUid} {
        allow read, write: if srSignedIn() && request.auth.uid == uid;
      }
    }

    // Groups are created by the moderator in the console.
    match /scriberocks_groups/{groupId} {
      allow read: if srSignedIn();
      allow write: if false;

      match /members/{uid} {
        allow read: if srSignedIn() && (request.auth.uid == uid || srMember(groupId));
        allow create, update: if srSignedIn() && request.auth.uid == uid && srMayJoin(groupId)
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'joinedAt', 'guardianApproved']);
        allow delete: if srSignedIn() && request.auth.uid == uid;
      }

      match /posts/{postId} {
        allow read: if srMember(groupId);
        // Members post as themselves, unreported, unless banned.
        allow create: if srMember(groupId) && !srBanned() && srPostingAllowed()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt', 'reportedBy'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 20000
          && request.resource.data.reportedBy == [];
        // A member may only add themselves to reportedBy.
        allow update: if srMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy'])
          && request.resource.data.reportedBy.toSet().difference(resource.data.reportedBy.toSet()) == [request.auth.uid].toSet()
          && resource.data.reportedBy.toSet().difference(request.resource.data.reportedBy.toSet()).size() == 0;
        // Only the author deletes (the moderator uses the email links).
        allow delete: if srSignedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // Reports: write-only for the reporter; the Cloud Function reads them.
    match /scriberocks_reports/{reportId} {
      allow create: if srSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Bans are set by the moderation function only.
    match /scriberocks_banned/{uid} {
      allow read, write: if false;
    }
  }
}
